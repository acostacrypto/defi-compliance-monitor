# ---------------------------------------------------------------------------
# Somnia network
# ---------------------------------------------------------------------------
SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
SOMNIA_CHAIN_ID=50312
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ---------------------------------------------------------------------------
# Somnia Agentic L1 — addresses and agent IDs
# Get real agent IDs from the Somnia Agent Explorer:
#   https://agents.testnet.somnia.network  (each agent -> Solidity tab)
# Never hardcode these in source. Scripts read them from here; deploy.ts
# passes them to the constructor; the contract stores them as immutable.
# ---------------------------------------------------------------------------
AGENT_REQUESTER_ADDRESS=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776
JSON_API_AGENT_ID=
LLM_PARSE_WEBSITE_AGENT_ID=
LLM_INFERENCE_AGENT_ID=

# ---------------------------------------------------------------------------
# Governance
# GUARDIAN_MULTISIG resolves ambiguous cases and controls emergency pause.
# PROTOCOL_TREASURY receives accumulated compliance fees.
# ---------------------------------------------------------------------------
GUARDIAN_MULTISIG=
PROTOCOL_TREASURY=

# ---------------------------------------------------------------------------
# Filled in after deploy.ts (also written to deployments/somnia-testnet.json)
# ---------------------------------------------------------------------------
COMPLIANCE_MONITOR_ADDRESS=

# ---------------------------------------------------------------------------
# Data sources consumed by the agent composition (JSON API + Parse Website)
# ---------------------------------------------------------------------------
SANCTIONS_API_URL=
LEGAL_SOURCE_URL=

# ---------------------------------------------------------------------------
# Explorer
# ---------------------------------------------------------------------------
EXPLORER_BASE_URL=https://shannon-explorer.somnia.network

# ---------------------------------------------------------------------------
# Optional tuning (sensible defaults applied if omitted)
# ---------------------------------------------------------------------------
# RESOLVE_TOPUP_STT=1.2
# MONITOR_SCAN_MS=15000
# LIST_TYPE=OFAC_SDN
