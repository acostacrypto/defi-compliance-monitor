  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.16",
    "@nomicfoundation/hardhat-viem": "^3.0.8",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "hardhat": "^3.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "viem": "^2.50.4"
  },
  "overrides": {
    "undici": "6.25.0"
  }

}
