{
  "name": "defi-compliance-monitor",
  "version": "1.0.0",
  "description": "Autonomous DeFi compliance monitor MVP built on Somnia Agentic L1",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test nodejs",
    "coverage": "hardhat coverage",
    "deploy:somnia": "hardhat run scripts/deploy.ts --network somniaTestnet",
    "check:sanctions": "hardhat run scripts/sanctionCheck.ts --network somniaTestnet",
    "reactivity": "hardhat run scripts/reactivityHandler.ts --network somniaTestnet",
    "monitor": "hardhat run scripts/autonomousMonitor.ts --network somniaTestnet",
    "escalate": "hardhat run scripts/escalateCase.ts --network somniaTestnet",
    "diagnose": "hardhat run scripts/diagnoseCompliance.ts --network somniaTestnet",
    "demo": "npm run check:sanctions"
  },
  "keywords": [
    "somnia",
