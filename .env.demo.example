# ---------------------------------------------------------------------------
# DEMO ENV TEMPLATE (copy/paste friendly)
# ---------------------------------------------------------------------------
# Usage:
#   cp .env.demo.example .env
#   # fill all <...> placeholders
#
# Important for demo:
# - Use ONE funded wallet for deploy + guardian + treasury.
# - Set GUARDIAN_MULTISIG and PROTOCOL_TREASURY to that same wallet address.
# ---------------------------------------------------------------------------

# Somnia network
SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
SOMNIA_CHAIN_ID=50312

# Deployer/operator private key (0x-prefixed)
PRIVATE_KEY=<0xYOUR_PRIVATE_KEY>

# Somnia Agentic L1 (from https://agents.testnet.somnia.network)
AGENT_REQUESTER_ADDRESS=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776
JSON_API_AGENT_ID=<YOUR_JSON_API_AGENT_ID>
LLM_PARSE_WEBSITE_AGENT_ID=<YOUR_LLM_PARSE_WEBSITE_AGENT_ID>
LLM_INFERENCE_AGENT_ID=<YOUR_LLM_INFERENCE_AGENT_ID>

# Demo addresses (same wallet for both)
# Replace with your wallet address derived from PRIVATE_KEY.
GUARDIAN_MULTISIG=<0xYOUR_WALLET_ADDRESS>
PROTOCOL_TREASURY=<0xYOUR_WALLET_ADDRESS>

# Fill after deployment
COMPLIANCE_MONITOR_ADDRESS=<0xDEPLOYED_COMPLIANCE_MONITOR>

# Optional sources (can stay blank for basic demo)
SANCTIONS_API_URL=
LEGAL_SOURCE_URL=

# Explorer
EXPLORER_BASE_URL=https://shannon-explorer.somnia.network

# Optional tuning
# RESOLVE_TOPUP_STT=0.5
# MONITOR_SCAN_MS=15000
# LIST_TYPE=OFAC_SDN
